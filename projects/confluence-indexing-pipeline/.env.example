# Local development settings. Copy to .env (git-ignored) and fill in the Confluence values:
#   cp .env.example .env && set -a && source .env && set +a
#
# In deployed environments set the same variables on the Airflow workers, and
# hold secrets in Airflow Connections (confluence_default, pgvector_default,
# openai_default) or reference them with *_SECRET_ID (AWS Secrets Manager).

PIPELINE_NAME=confluence-indexing
ENVIRONMENT=local

# --- Confluence (Cloud: email + API token; Data Center: leave USERNAME empty, token = PAT)
CONFLUENCE_BASE_URL=https://your-site.atlassian.net/wiki
CONFLUENCE_USERNAME=you@example.com
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEYS=ENG
# CQL compares dates in the API user's profile timezone.
CONFLUENCE_CQL_TIMEZONE=Europe/London

# --- Embeddings: local Ollama (`ollama serve` then `ollama pull nomic-embed-text`)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
OLLAMA_BASE_URL=http://localhost:11434
# Hosted alternatives:
#   EMBEDDING_PROVIDER=openai  EMBEDDING_MODEL=text-embedding-3-large  EMBEDDING_DIMENSIONS=1536  OPENAI_API_KEY=...
#   EMBEDDING_PROVIDER=bedrock EMBEDDING_MODEL=amazon.titan-embed-text-v2:0  EMBEDDING_DIMENSIONS=1024
# Changing the model or dimensions needs a fresh schema (see README, "Changing embedding model").

# --- Chunking
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
# JSON array of regexes; a block matching one in full is dropped as boilerplate.
BOILERPLATE_PATTERNS=[]

# --- PostgreSQL + pgvector (deployment/docker-compose.yml)
PG_DSN=postgresql://indexer:indexer@localhost:5433/confluence_index

# --- AWS, pointed at LocalStack. Remove these four lines to use real AWS.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=eu-west-2

LANDING_BUCKET=confluence-indexing-landing
LANDING_PREFIX=confluence-indexing
METRICS_NAMESPACE=ConfluenceIndexing
ALERT_TOPIC_ARN=arn:aws:sns:eu-west-2:000000000000:confluence-indexing-alerts

# --- Guardrails (defaults shown)
WATERMARK_OVERLAP_MINUTES=30
MAX_FAILURE_RATIO=0.1
MAX_PAGE_ATTEMPTS=5
MAX_DELETE_RATIO=0.2
MASS_DELETE_MIN_PAGES=10
