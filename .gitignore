# JetBrains IDE. Patterns are deliberately unanchored so they keep working
# regardless of how deeply a project is nested.
.idea/
*.iml

# Local environment files. The committed template is the exception.
.env
.env.*
!.env.example

# Terraform provider cache and local state.
# .terraform.lock.hcl is intentionally NOT ignored - it is a dependency lock
# file and should be committed.
.terraform/
*.tfstate
*.tfstate.backup

# dbt local machine state. .test_env is deliberately NOT ignored.
.user.yml

.DS_Store

target/
dbt_packages/
logs/

__pycache__/
*.pyc
